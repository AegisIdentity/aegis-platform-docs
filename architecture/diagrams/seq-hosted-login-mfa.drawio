    <mxCell id="c14" value="1. open app / click Sign in" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="150" as="sourcePoint"/><mxPoint x="365" y="150" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c15" value="2. 302 to https://gw/{tenant}/oauth2/authorize (PKCE S256 challenge, state)" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="194" as="sourcePoint"/><mxPoint x="135" y="194" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c16" value="3. GET /{tenant}/oauth2/authorize" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="238" as="sourcePoint"/><mxPoint x="595" y="238" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c17" value="4. forward (preserveHost: issuer = https://gw/{tenant})" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="282" as="sourcePoint"/><mxPoint x="825" y="282" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c18" value="5. 302 /login (no session) — hosted, branded login page" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="326" as="sourcePoint"/><mxPoint x="135" y="326" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c19" value="6. POST /login (organization + username + password, CSRF) via gateway" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="370" as="sourcePoint"/><mxPoint x="825" y="370" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c20" value="7. users:authenticate (service JWT) — Argon2id verify + lockout" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="414" as="sourcePoint"/><mxPoint x="1055" y="414" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c21" value="8. OK — FACTOR_PASSWORD granted" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="458" as="sourcePoint"/><mxPoint x="825" y="458" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c22" value="9. policy requires MFA — factors enrolled?" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="502" as="sourcePoint"/><mxPoint x="1285" y="502" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c23" value="10. TOTP enrolled" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1285" y="546" as="sourcePoint"/><mxPoint x="825" y="546" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c24" value="11. 302 /mfa — pending gate ARMED: /oauth2/authorize is blocked" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="590" as="sourcePoint"/><mxPoint x="135" y="590" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c25" value="12. POST /mfa (TOTP code) via gateway" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="634" as="sourcePoint"/><mxPoint x="825" y="634" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c26" value="13. validate TOTP (RFC 6238)" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="678" as="sourcePoint"/><mxPoint x="1285" y="678" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c27" value="14. valid" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1285" y="722" as="sourcePoint"/><mxPoint x="825" y="722" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c28" value="15. gate cleared — 302 resume authorize, code issued" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="766" as="sourcePoint"/><mxPoint x="135" y="766" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c29" value="16. GET /callback?code=...&amp;state=..." style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="810" as="sourcePoint"/><mxPoint x="365" y="810" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c30" value="17. POST /{tenant}/oauth2/token + code_verifier (via gateway)" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="854" as="sourcePoint"/><mxPoint x="825" y="854" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c31" value="18. access + id + refresh tokens — iss = https://gw/{tenant}, signed with the TENANT key" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="898" as="sourcePoint"/><mxPoint x="365" y="898" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c32" value="Zero-trust: no code or token can be issued while the second factor is pending — MfaPendingGateFilter blocks /oauth2/authorize at the protocol chain, so a password-only session cannot mint tokens by navigating directly. Tokens carry the per-tenant issuer and are signed with the tenant&#x27;s own key; resource servers verify signature + issuer allowlist + scope on every call." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;spacing=4;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="992" width="1360" height="80" as="geometry"/></mxCell>
  </root>
