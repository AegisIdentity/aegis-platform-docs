    <mxCell id="c4" value="Edge Gateway :8080" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="190" height="44" as="geometry"/></mxCell>
    <mxCell id="c5" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="104" as="sourcePoint"/><mxPoint x="365" y="592" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c6" value="Authorization Server" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="190" height="44" as="geometry"/></mxCell>
    <mxCell id="c7" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="104" as="sourcePoint"/><mxPoint x="595" y="592" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c8" value="identity-service" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="730" y="60" width="190" height="44" as="geometry"/></mxCell>
    <mxCell id="c9" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="104" as="sourcePoint"/><mxPoint x="825" y="592" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c10" value="1. POST /{tenant}/oauth2/token — Basic clientId:secret, grant_type=client_credentials, scope" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="150" as="sourcePoint"/><mxPoint x="365" y="150" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c11" value="2. forward (preserveHost: issuer = https://gw/{tenant})" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="194" as="sourcePoint"/><mxPoint x="595" y="194" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c12" value="3. authenticate client, mint access token:&#10;tenant claim from client, TENANT signing key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFCC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="495" y="238" width="200" height="34" as="geometry"/></mxCell>
    <mxCell id="c13" value="4. access_token (expires_in 300)" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="290" as="sourcePoint"/><mxPoint x="135" y="290" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c14" value="5. GET /api/v1/users — Authorization: Bearer" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="334" as="sourcePoint"/><mxPoint x="365" y="334" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c15" value="6. route (Origin stripped — the gateway routes, it does not authorize)" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="378" as="sourcePoint"/><mxPoint x="825" y="378" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c16" value="7. fetch aggregate JWKS — GET /internal/jwks (in-network, cached, all tenant public keys)" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="422" as="sourcePoint"/><mxPoint x="595" y="422" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c17" value="8. verify signature + issuer allowlist +&#10;scope; every query tenant-scoped" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFCC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="725" y="466" width="200" height="34" as="geometry"/></mxCell>
    <mxCell id="c18" value="9. 200 — users for this tenant only" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="518" as="sourcePoint"/><mxPoint x="135" y="518" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c19" value="Zero-trust: the resource server validates every request itself — signature against the aggregate JWKS (fetched in-network from the AS), issuer against an explicit allowlist (root + gateway per-tenant issuers), and the required scope per endpoint. Cross-tenant access is impossible by construction: repositories only expose tenant-scoped queries keyed by the token&#x27;s tenant claim." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;spacing=4;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="900" height="80" as="geometry"/></mxCell>
  </root>
</mxGraphModel>
