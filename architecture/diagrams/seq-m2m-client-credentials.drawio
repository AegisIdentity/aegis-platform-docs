    <mxCell id="c1" value="Machine-to-machine (client_credentials) + zero-trust validation at the resource server" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell>
    <mxCell id="c2" value="Tenant backend service" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="190" height="44" as="geometry"/></mxCell>
