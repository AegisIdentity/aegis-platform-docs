<mxGraphModel adaptiveColors="auto" grid="0" page="1" pageScale="1" pageWidth="1600" pageHeight="1120" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t" value="Aegis — AWS Deployment (Terraform), zero-trust" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="u" value="Users / tenant apps&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;browsers, mobile, backends&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="80" width="180" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="r53" value="Route 53&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;auth.example.com + tenant custom domains (CNAME + ACM)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="180" width="180" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="waf" value="AWS WAF&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;managed rules + bot control + rate limiting per IP/tenant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="290" width="180" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="region" value="AWS Region (multi-AZ)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#FAFAFA;strokeColor=#232F3E;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="260" y="70" width="1020" height="850" as="geometry"/>
    </mxCell>
    <mxCell id="vpc" value="VPC 10.0.0.0/16 — flow logs on, no default SG use" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#F5F7FA;strokeColor=#8892A6;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="280" y="105" width="980" height="790" as="geometry"/>
    </mxCell>
    <mxCell id="pub" value="Public subnets (2 AZs) — the ONLY internet-facing tier" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#FDEFE3;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="300" y="140" width="450" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="alb" value="Application Load Balancer&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;TLS 1.2+ (ACM certs, per-tenant SAN/SNI)&lt;br&gt;HTTP→HTTPS redirect, security headers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="170" width="250" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="nat" value="NAT GW&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;egress only: external IdPs (Google/Entra/Apple), SAML metadata&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="590" y="170" width="140" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="app" value="Private app subnets (2 AZs) — ECS Fargate, no public IPs, SG-to-SG rules only" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#EDF2FB;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="300" y="300" width="700" height="330" as="geometry"/>
    </mxCell>
    <mxCell id="gwt" value="edge-gateway task&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;only target of the ALB;&lt;br&gt;per-tenant issuer front-door&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="335" width="200" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="ast" value="authorization-server task&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;internal-only; tenant keys via KMS;&lt;br&gt;aggregate JWKS /internal/jwks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="560" y="335" width="220" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="con2" value="admin-console&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;S3 + CloudFront (OAC) or Fargate nginx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="800" y="335" width="180" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="svc2" value="service tasks (Cloud Map service discovery, ECS Service Connect TLS)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;identity · mfa-webauthn · social-broker · tenant · admin-api · scim&lt;br&gt;each: own task role (least privilege), own SG, JWT validation + scopes on every request&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
      <mxGeometry x="320" y="440" width="660" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="vpce" value="VPC endpoints (PrivateLink): ECR, Secrets Manager, KMS, CloudWatch Logs, S3 — AWS API calls never traverse the internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="545" width="660" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="dat" value="Private data subnets (2 AZs) — no route to IGW/NAT; reachable only from app-tier SGs" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#F3E8F7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="300" y="650" width="940" height="220" as="geometry"/>
    </mxCell>
    <mxCell id="rds" value="RDS PostgreSQL (Multi-AZ)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;database-per-service, KMS-encrypted at rest, TLS in transit, IAM auth, automated backups + PITR&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="690" width="280" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="ec" value="ElastiCache Redis&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;TLS + AUTH, cluster mode&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="630" y="690" width="220" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="msk" value="Amazon MSK&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;IAM auth, TLS, private brokers&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="880" y="690" width="220" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="side" value="Account-level security services" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#FFF8F0;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="1300" y="70" width="260" height="850" as="geometry"/>
    </mxCell>
    <mxCell id="kms" value="KMS&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;per-tenant signing keys wrapped; envelope encryption; rotation with overlap (ADR-0007)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1320" y="105" width="220" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="sm" value="Secrets Manager&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;DB creds (rotated), client secrets — injected at task start, never in images/env files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1320" y="200" width="220" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="iam" value="IAM&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;per-task roles, least privilege, no wildcard actions; IMDSv2 enforced&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1320" y="295" width="220" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="ecr" value="ECR&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;image scanning on push, immutable tags, signed images&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1320" y="390" width="220" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="obs" value="CloudWatch + CloudTrail + GuardDuty + Security Hub&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;central logs/metrics, audit trail, threat detection, posture checks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1320" y="475" width="220" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="tf" value="Terraform (aegis-platform-infra)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;remote state (S3 + lock), CI plan/apply, no console changes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1320" y="580" width="220" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u" target="r53" value="DNS">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r53" target="waf" value="HTTPS only">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="waf" target="alb" value="">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="alb" target="gwt" value="TLS to task SG">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gwt" target="ast" value="/{tenant}/oauth2/*">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="gwt" target="svc2" value="scoped bearer">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="ast" target="svc2" value="service JWTs / JWKS">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svc2" target="rds" value="TLS, IAM auth">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.55;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svc2" target="ec" value="">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svc2" target="msk" value="">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="a11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="ast" target="nat" value="egress to external IdPs only">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="zt" value="&lt;b&gt;Zero-trust on AWS&lt;/b&gt;&lt;br&gt;1. Identity-based access everywhere: per-task IAM roles, RDS IAM auth, MSK IAM auth, KMS grants per service — no shared credentials.&amp;nbsp;&amp;nbsp;2. Network as containment, not trust: tasks have no public IPs; SG-to-SG references only (ALB→gateway, gateway→services, services→data); data subnets have no internet route; VPC endpoints keep AWS traffic private.&amp;nbsp;&amp;nbsp;3. Every service still validates JWT signature + issuer allowlist + scope on every request — the VPC is not a trust boundary.&amp;nbsp;&amp;nbsp;4. Per-tenant issuers via the ALB/gateway host; per-tenant signing keys wrapped in KMS, rotated with overlap.&amp;nbsp;&amp;nbsp;5. Encrypt everything: TLS 1.2+ in transit end-to-end, KMS at rest (RDS, EBS, logs, S3).&amp;nbsp;&amp;nbsp;6. Detect + audit: CloudTrail (org trail), GuardDuty, Security Hub, WAF logs, VPC flow logs → CloudWatch; alerts on drift.&amp;nbsp;&amp;nbsp;7. Supply chain: ECR scan-on-push, immutable tags, CI-only deploys via Terraform." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=10;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="40" y="940" width="1520" height="130" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
