    <mxCell id="c4" value="Edge Gateway :8080" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="270" y="60" width="190" height="44" as="geometry"/></mxCell>
    <mxCell id="c5" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="104" as="sourcePoint"/><mxPoint x="365" y="848" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c6" value="Authorization Server" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="500" y="60" width="190" height="44" as="geometry"/></mxCell>
    <mxCell id="c7" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="104" as="sourcePoint"/><mxPoint x="595" y="848" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c8" value="mfa-webauthn-service" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="730" y="60" width="190" height="44" as="geometry"/></mxCell>
    <mxCell id="c9" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="104" as="sourcePoint"/><mxPoint x="825" y="848" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c10" value="Tenant&#x27;s own API" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fontSize=11;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="960" y="60" width="190" height="44" as="geometry"/></mxCell>
    <mxCell id="c11" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="104" as="sourcePoint"/><mxPoint x="1055" y="848" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c12" value="1. POST /api/v1/webauthn/login/options { clientId }" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="150" as="sourcePoint"/><mxPoint x="365" y="150" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c13" value="2. route (Origin stripped; permissive no-credential CORS at the edge)" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="194" as="sourcePoint"/><mxPoint x="595" y="194" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c14" value="3. assertion options (per-tenant Relying Party: rpId + allowed origins)" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="238" as="sourcePoint"/><mxPoint x="825" y="238" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c15" value="4. challenge + challengeId (single-use)" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="282" as="sourcePoint"/><mxPoint x="595" y="282" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c16" value="5. PublicKeyCredentialRequestOptions" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="326" as="sourcePoint"/><mxPoint x="135" y="326" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c17" value="6. navigator.credentials.get() /&#10;Credential Manager / ASAuthorization" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFCC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="35" y="370" width="200" height="34" as="geometry"/></mxCell>
    <mxCell id="c18" value="7. POST /api/v1/webauthn/login/finish + PKCE code_challenge (via gateway)" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="422" as="sourcePoint"/><mxPoint x="595" y="422" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c19" value="8. verify assertion (signature over challenge, origin, sign-count)" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="466" as="sourcePoint"/><mxPoint x="825" y="466" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c20" value="9. verified — user resolved" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825" y="510" as="sourcePoint"/><mxPoint x="595" y="510" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c21" value="10. interaction_code (single-use, 2-min TTL, client-bound, PKCE-bound)" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="554" as="sourcePoint"/><mxPoint x="135" y="554" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c22" value="11. POST /api/v1/oauth/interaction/token { interaction_code, code_verifier } (via gateway)" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="598" as="sourcePoint"/><mxPoint x="595" y="598" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c23" value="12. access + id tokens — iss = https://gw/{tenant}, signed with the TENANT key" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="595" y="642" as="sourcePoint"/><mxPoint x="135" y="642" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c24" value="13. call the tenant&#x27;s API with Bearer access_token" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="135" y="686" as="sourcePoint"/><mxPoint x="1055" y="686" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c25" value="14. validate: OIDC discovery at https://gw/{tenant}/.well-known + JWKS (standard libs)" style="html=1;fontSize=10;endArrow=block;endFill=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="730" as="sourcePoint"/><mxPoint x="365" y="730" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c26" value="15. 200 — sub / tenant / scope claims trusted" style="html=1;fontSize=10;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1055" y="774" as="sourcePoint"/><mxPoint x="135" y="774" as="targetPoint"/></mxGeometry></mxCell>
    <mxCell id="c27" value="Zero-trust: the ceremony proves possession of the passkey against a single-use server challenge (phishing-resistant); the interaction code is PKCE-bound so only the app instance that started the flow can redeem it. The minted tokens are standard OIDC tokens with the per-tenant issuer — the tenant&#x27;s own API validates them with any off-the-shelf JWT library via the gateway discovery endpoints, never by trusting the network." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;spacingLeft=8;spacing=4;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="40" y="868" width="1130" height="80" as="geometry"/></mxCell>
  </root>
</mxGraphModel>
