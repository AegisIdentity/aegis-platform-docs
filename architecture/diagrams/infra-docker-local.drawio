<mxGraphModel adaptiveColors="auto" grid="0" page="1" pageScale="1" pageWidth="1480" pageHeight="1000" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t" value="Aegis — Local Docker Deployment (docker compose), hardened / zero-trust posture" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="host" value="Developer machine — Docker Desktop / Engine" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#FAFAFA;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="40" y="70" width="1400" height="700" as="geometry"/>
    </mxCell>
    <mxCell id="dev" value="Developer browser&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;localhost only — nothing is exposed off-host&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="70" y="120" width="200" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="net" value="compose network &quot;aegis&quot; (bridge) — services resolve each other by name; no host networking" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#F5F7FA;strokeColor=#8892A6;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="320" y="110" width="1090" height="530" as="geometry"/>
    </mxCell>
    <mxCell id="con" value="admin-console (nginx)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;published :3000 → 80&lt;br&gt;static SPA, no secrets baked in&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="150" width="230" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="gwc" value="edge-gateway&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;published :8080 — THE public front door&lt;br&gt;per-tenant issuer /{tenant}/oauth2/*, CORS owner,&lt;br&gt;strips Origin + X-Aegis-Tenant, preserveHost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="250" width="230" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="asc" value="authorization-server&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;:9000 published DEV-ONLY (console OIDC);&lt;br&gt;production: internal-only behind the gateway&lt;br&gt;per-tenant keys in-memory (dev) / KMS (prod)&lt;br&gt;aggregate JWKS at /internal/jwks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="700" y="150" width="260" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="svcbox" value="Internal services — not published in hardened mode (dev exposes ports for debugging only)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#EDF2FB;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="700" y="270" width="680" height="200" as="geometry"/>
    </mxCell>
    <mxCell id="sv1" value="identity-service :9102" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="720" y="300" width="200" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="sv2" value="mfa-webauthn-service :9103" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="945" y="300" width="200" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="sv3" value="social-broker-service :9105" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1170" y="300" width="200" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="sv4" value="tenant-service :9101" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="720" y="360" width="200" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="sv5" value="admin-api-service :9107" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="945" y="360" width="200" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="sv6" value="scim-provisioning-service :9106" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1170" y="360" width="200" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="ztsvc" value="Every service validates JWTs itself: aggregate JWKS fetched in-network (authorization-server:9000/internal/jwks) + issuer allowlist (localhost:9000, authorization-server:9000, localhost:8080, edge-gateway:8080) + per-endpoint scopes. The compose network is NOT a trust boundary. Dashed arrows = internal service-JWT calls; each service reaches only its own database." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;fillColor=none;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="720" y="410" width="640" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="pg" value="postgres:16&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;database-per-service (7 DBs)&lt;br&gt;named volume pgdata (persistent)&lt;br&gt;:5432 published DEV-ONLY&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="350" y="490" width="230" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="rd" value="redis:7&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;no persistence, rate-limit / cache&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="640" y="490" width="220" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="kf" value="kafka (KRaft)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;event backbone&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="900" y="490" width="220" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="dev" target="con" value=":3000 SPA">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="dev" target="gwc" value=":8080 all APIs + per-tenant OAuth">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ed3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="gwc" target="asc">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ed3l" value="OAuth + hosted login + tenant-app API" style="edgeLabel;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#FFFFFF;fontSize=10;" vertex="1" connectable="0" parent="ed3"><mxGeometry x="0" relative="1" width="110" height="42" as="geometry"/></mxCell>
    <mxCell id="ed4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;entryX=0;entryY=0.1;" edge="1" parent="1" source="gwc" target="svcbox">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ed4l" value="management APIs (scoped bearer)" style="edgeLabel;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;labelBackgroundColor=#FFFFFF;fontSize=10;" vertex="1" connectable="0" parent="ed4"><mxGeometry x="0" relative="1" width="110" height="42" as="geometry"/></mxCell>
    <mxCell id="ed5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="asc" target="svcbox">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ed6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svcbox" target="rd" value="">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ed7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.05;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svcbox" target="pg">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="ed8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svcbox" target="kf" value="">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="zt" value="&lt;b&gt;Zero-trust checklist (local)&lt;/b&gt;&lt;br&gt;1. One front door: only :3000 (console) and :8080 (gateway) need publishing — :9000 / :5432 / service ports are dev conveniences; remove them for a hardened stack.&amp;nbsp;&amp;nbsp;2. No implicit network trust: every service validates JWT signature + issuer allowlist + scope on every call, even from inside the compose network.&amp;nbsp;&amp;nbsp;3. Per-tenant issuers + keys end-to-end (issuer = http://localhost:8080/{tenant}).&amp;nbsp;&amp;nbsp;4. DB-per-service; no service can read another's data.&amp;nbsp;&amp;nbsp;5. Dev credentials ({noop} secrets, dev-only-change-me) are seed data ONLY — production uses a secret store and hashed client secrets.&amp;nbsp;&amp;nbsp;6. Never run docker compose down -v: the pgdata volume is the persistent state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=10;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="40" y="800" width="1400" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="ed0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="con" target="asc" value="OIDC">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
