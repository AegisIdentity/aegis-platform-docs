<mxGraphModel adaptiveColors="auto" dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1060" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
