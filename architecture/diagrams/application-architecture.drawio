    <mxCell id="t1" value="Aegis IAM Platform — Application Architecture (multi-tenant, zero-trust)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="cl0" value="Clients" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#F5F7FA;strokeColor=#8892A6;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="40" y="70" width="250" height="620" as="geometry"/>
    </mxCell>
    <mxCell id="cl1" value="Admin Console / End-user Portal&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;React SPA — OIDC authorization_code + PKCE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="60" y="105" width="210" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="cl2" value="Tenant web app&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;hosted OIDC or embedded passkey login&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="60" y="185" width="210" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="cl3" value="Tenant mobile app&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;native social SDK / passkeys + interaction code&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="60" y="260" width="210" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="cl4" value="Tenant SaaS backend&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;client_credentials (M2M), management APIs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="60" y="335" width="210" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="cl5" value="Upstream IdP (Entra / Okta / Workday)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SCIM 2.0 provisioning push&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="60" y="410" width="210" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="cl6" value="External identity providers&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Google, Entra ID, Apple, GitHub, generic OIDC, SAML 2.0 IdPs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="60" y="560" width="210" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="gw" value="Edge Gateway :8080&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;single public entry (TLS/WAF at ingress)&lt;br&gt;per-tenant issuer front-door /{tenant}/oauth2/*&lt;br&gt;preserveHostHeader — issuer = gateway host&lt;br&gt;tenant resolution, strips X-Aegis-Tenant + Origin&lt;br&gt;path-split CORS (tenant-app open, mgmt locked)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="370" y="180" width="250" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="mesh" value="Private service network — no direct public exposure" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#F5F7FA;strokeColor=#8892A6;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="780" y="70" width="560" height="620" as="geometry"/>
    </mxCell>
    <mxCell id="as" value="authorization-server :9000&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;Spring Authorization Server 7.1 — OAuth 2.1 / OIDC&lt;br&gt;per-tenant issuers (multipleIssuersAllowed) + per-tenant signing keys (kid aegis-&amp;lt;tenant&amp;gt;)&lt;br&gt;hosted login (password / passkey / social / SAML), MFA step-up gate&lt;br&gt;tenant-app embedded auth API (webauthn / social/native / interaction-code)&lt;br&gt;aggregate JWKS: GET /internal/jwks (union of tenant public keys)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;align=left;spacingLeft=8;" vertex="1" parent="1">
      <mxGeometry x="800" y="105" width="520" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="s1" value="identity-service :9102&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;users, groups, Argon2id credentials, lockout, signup policy, branding, system log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="800" y="245" width="250" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="s2" value="mfa-webauthn-service :9103&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;TOTP (RFC 6238), passkeys (webauthn4j), per-tenant Relying Party config&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1070" y="245" width="250" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="s3" value="social-broker-service :9105&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;per-tenant IdP catalog (OIDC + SAML), client registrations for the AS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="800" y="335" width="250" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="s4" value="tenant-service :9101&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;organizations, onboarding, custom domains (CNAME + TXT verify)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1070" y="335" width="250" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="s5" value="admin-api-service :9107&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;RBAC: admin roles + permissions (SUPER_ADMIN, HELP_DESK, ...)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="800" y="425" width="250" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="s6" value="scim-provisioning-service :9106&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;SCIM 2.0 inbound (/scim/v2), connector tokens, provisions via identity-service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1070" y="425" width="250" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="zt1" value="Zero-trust inside the mesh: every service validates JWTs itself (split-horizon decoder: aggregate JWKS fetched in-network + issuer allowlist incl. gateway per-tenant issuers), enforces scopes per endpoint, and scopes every query by tenant. The network is never trusted; the gateway routes but does not authorize. Dashed arrows = AS-internal calls over short-lived service JWTs (credential verify to identity, MFA/passkey ceremonies to mfa) and outbound federation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFCC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=8;spacing=4;" vertex="1" parent="1">
      <mxGeometry x="800" y="520" width="520" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="data" value="Data tier (private subnets / network)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#F5F7FA;strokeColor=#8892A6;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="1470" y="70" width="270" height="620" as="geometry"/>
    </mxCell>
    <mxCell id="d1" value="PostgreSQL&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;database-per-service (ADR-0002):&lt;br&gt;aegis_authz, aegis_identity, aegis_tenant, aegis_social, aegis_mfa, aegis_admin, aegis_scim&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1500" y="110" width="210" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="d2" value="Redis&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;rate limiting / caching (edge)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1500" y="270" width="210" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="d3" value="Kafka&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;event backbone (audit / lifecycle events)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1500" y="380" width="210" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="d4" value="KMS / Key Vault (production)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;per-tenant signing keys wrapped at rest, rotation with overlap (ADR-0007)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1500" y="490" width="210" height="80" as="geometry"/>
    </mxCell>
