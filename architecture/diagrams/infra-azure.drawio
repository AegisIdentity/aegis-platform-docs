    <mxCell id="b4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gwa" target="asa">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="b5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="gwa" target="svca" value="scoped bearer (mTLS)">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="b6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="asa" target="svca" value="service JWTs / JWKS">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="b7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svca" target="pg2" value="private endpoint, Entra auth">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="b8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.55;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svca" target="rd2" value="">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="b9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svca" target="eh" value="">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="b10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="asa" target="kv" value="unwrap tenant keys (managed identity)">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="zt" value="&lt;b&gt;Zero-trust on Azure&lt;/b&gt;&lt;br&gt;1. Identity-first: managed identity per app — Postgres, Redis, Event Hubs, Key Vault and ACR all authenticate with Entra ID; zero connection strings or embedded secrets.&amp;nbsp;&amp;nbsp;2. Private everything: Front Door → Private Link is the only ingress; the Container Apps environment is internal; every PaaS service has public network access disabled and a private endpoint + Private DNS.&amp;nbsp;&amp;nbsp;3. Services still verify JWT signature + issuer allowlist + scope on every request (the VNet is not a trust boundary); east-west traffic is mTLS.&amp;nbsp;&amp;nbsp;4. Per-tenant issuers via the gateway host; per-tenant signing keys non-exportable in Managed HSM, rotated with overlap.&amp;nbsp;&amp;nbsp;5. Encrypt in transit (TLS 1.2+) and at rest (CMK for Postgres, storage, logs).&amp;nbsp;&amp;nbsp;6. Guardrails + detection: Azure Policy (deny public IPs / non-private PaaS), Defender for Cloud, Sentinel analytics, WAF + NSG flow logs.&amp;nbsp;&amp;nbsp;7. Operators: PIM just-in-time access + MFA + Conditional Access; CI deploys via Terraform with OIDC federation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;spacingLeft=10;spacing=6;" vertex="1" parent="1">
      <mxGeometry x="40" y="940" width="1520" height="140" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
