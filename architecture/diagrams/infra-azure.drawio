<mxGraphModel adaptiveColors="auto" grid="0" page="1" pageScale="1" pageWidth="1600" pageHeight="1120" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="t" value="Aegis — Azure Deployment (Terraform), zero-trust" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="u" value="Users / tenant apps&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;browsers, mobile, backends&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="80" width="180" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="afd" value="Azure Front Door Premium&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;global anycast, TLS 1.2+ (managed certs, per-tenant custom domains), WAF policy (managed rules + rate limits), Private Link origin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="180" width="180" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="sub" value="Azure Subscription — landing zone, Azure Policy guardrails" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#FAFAFA;strokeColor=#0078D4;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="260" y="70" width="1020" height="850" as="geometry"/>
    </mxCell>
    <mxCell id="vnet" value="VNet 10.10.0.0/16 — NSGs per subnet, Private DNS zones, no public IPs on workloads" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#F5F7FA;strokeColor=#8892A6;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="280" y="105" width="980" height="790" as="geometry"/>
    </mxCell>
    <mxCell id="pl" value="Private Link ingress — Front Door is the ONLY way in (internal load balancer, no public endpoint on the environment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEFE3;strokeColor=#D79B00;fontSize=10;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="300" y="140" width="680" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="cae" value="Container Apps Environment (VNet-injected, internal-only ingress)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#EDF2FB;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="300" y="210" width="680" height="420" as="geometry"/>
    </mxCell>
    <mxCell id="gwa" value="edge-gateway app&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;the only app with environment ingress;&lt;br&gt;per-tenant issuer front-door /{tenant}/oauth2/*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="245" width="240" height="85" as="geometry"/>
    </mxCell>
    <mxCell id="asa" value="authorization-server app&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;internal ingress only; tenant signing keys from Key Vault (Managed HSM); aggregate JWKS /internal/jwks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="600" y="245" width="240" height="85" as="geometry"/>
    </mxCell>
    <mxCell id="cona" value="admin-console&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;Static Web App / nginx app behind Front Door&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="780" y="355" width="180" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="svca" value="service apps — internal ingress, mTLS east-west (built-in Envoy)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;identity · mfa-webauthn · social-broker · tenant · admin-api · scim&lt;br&gt;each: own managed identity, Key Vault references (no secrets in env), JWT validation + scopes on every request&lt;br&gt;KEDA autoscale · zone redundancy · health probes · revisions for safe rollout/rollback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
      <mxGeometry x="320" y="450" width="640" height="105" as="geometry"/>
    </mxCell>
    <mxCell id="pesub" value="Private-endpoint subnet — all PaaS data services private, public network access DISABLED" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=bottom;fontStyle=1;fillColor=#F3E8F7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="300" y="660" width="940" height="225" as="geometry"/>
    </mxCell>
    <mxCell id="pg2" value="Azure Database for PostgreSQL&lt;br&gt;Flexible Server (zone-redundant HA)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;database-per-service, CMK encryption (Key Vault), Entra ID auth, TLS enforced, PITR backups&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="320" y="695" width="300" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="rd2" value="Azure Cache for Redis&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;TLS only, private endpoint, Entra ID auth&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="650" y="695" width="240" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="eh" value="Event Hubs (Kafka API)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;private endpoint, managed-identity auth&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="920" y="695" width="240" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="side2" value="Platform security services" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fillColor=#FFF8F0;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="1300" y="70" width="260" height="850" as="geometry"/>
    </mxCell>
    <mxCell id="kv" value="Key Vault + Managed HSM&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;per-tenant signing keys (non-exportable), rotation with overlap; secrets via Key Vault references; RBAC + purge protection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1320" y="105" width="220" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="mi" value="Entra ID — workload identities&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;managed identity per app; no connection strings; PIM + MFA for operators; Conditional Access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1320" y="220" width="220" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="acr" value="Azure Container Registry (Premium)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;private endpoint, Defender image scanning, content trust&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1320" y="325" width="220" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="mon" value="Azure Monitor + Log Analytics + Microsoft Sentinel&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;central logs, SIEM detections, WAF + NSG flow logs, alerts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1320" y="420" width="220" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="dfc" value="Defender for Cloud&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;posture management, container + DB protection plans&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1320" y="525" width="220" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="tf2" value="Terraform (aegis-platform-infra)&lt;br&gt;&lt;font style=&quot;font-size:10px;font-weight:normal&quot;&gt;remote state, CI plan/apply with OIDC federation (no cloud secrets in CI)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAF6;strokeColor=#5C6BC0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1320" y="620" width="220" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="u" target="afd" value="HTTPS only">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="afd" target="pl" value="Private Link (no public origin)">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="b3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pl" target="gwa" value="">
      <mxGeometry relative="1" as="geometry"/>
